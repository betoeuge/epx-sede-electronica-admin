<style id='mfn-custom-inline-css' type='text/css'>
/* Input */
.acf-user-register-fields .acf-input input[type=text]{
	width:509px;
	max-width:509px;
	padding-right:4px;
}

/* Input */
.sections_group .mcb-section .section_wrapper .the_content_wrapper .learnpress #learn-press-profile .lp-content-area .learn-press-form form .acf-user-register-fields .acf-field-email .acf-input .acf-input-wrap input[type=email]{
	width:100% !important;
}

/* Input */
.sections_group .mcb-section .section_wrapper .the_content_wrapper .learnpress #learn-press-profile .lp-content-area .learn-press-form form .acf-user-register-fields .acf-field-number .acf-input .acf-input-wrap input[type=number]{
	width:100% !important;
}

/* Acf field text */
#learn-press-profile form .acf-field-text{
	padding-bottom:12px;
}

/* Section */
.sections_group .mcb-section{
	transform:translatex(0px) translatey(0px);
}

/* Acf field email */
#learn-press-profile form .acf-field-email{
	padding-bottom:12px;
}

/* Acf field number */
#learn-press-profile form .acf-field-number{
	padding-bottom:12px;
}

/* Button */
#learn-press-profile p button{
	margin-top:20px;
	margin-bottom:20px;
	
}

</style>
